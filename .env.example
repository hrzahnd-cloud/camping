# Kopieren nach .env und mit echten Werten befüllen.
# NIEMALS echte Zugangsdaten in dieser Beispieldatei oder ins Git-Repo eintragen.

# Datenbankverbindung: Atoll stellt für die von ihm verwaltete Postgres-
# Instanz DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD bereit, daraus baut
# die App die Verbindung zusammen. Für lokale Entwicklung kann stattdessen
# eine vollständige DATABASE_URL in der eigenen, nicht versionierten .env
# gesetzt werden (hat Vorrang) - absichtlich nicht hier aufgeführt, damit
# Atoll sie nicht mit einem lokalen Platzhalterwert befüllt.
DB_HOST=db
DB_PORT=5432
DB_NAME=campingverwaltung
DB_USER=camping_user
DB_PASSWORD=

APP_NAME=Campingverwaltung Aeschi
ENVIRONMENT=development

# E-Mail-Versand (Reservationsantworten, Rechnungen)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_ABSENDER=info@camping-aeschi.ch

# E-Mail-Eingang für Reservationsanfragen (IMAP). Ohne IMAP_HOST/IMAP_USER/
# IMAP_PASSWORD ist der automatische Import aus. Intervall in Sekunden, 0 = nur manuell.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_ORDNER=INBOX
MAIL_IMPORT_INTERVALL_SEKUNDEN=300

# HESTA-Meldung ans BFS per E-Mail. Der Versand bleibt aus (false), bis das BFS
# Format und Freischaltung bestätigt hat; zusätzlich muss SMTP konfiguriert sein.
HESTA_EMPFAENGER=hotelstatistik@bfs.admin.ch
HESTA_EMAIL_VERSAND_AKTIV=false

# Mailchimp (Newsletter) - erst befüllen, sobald eingerichtet (Konzept Abschnitt 11.4)
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# Feratel Deskline (Kurtaxe-Meldung) - erst befüllen nach PMS-Partner-Freischaltung
FERATEL_ENDPOINT_URL=
FERATEL_GEMEINDE_NUMMER=
FERATEL_FIRMEN_NUMMER=
FERATEL_BENUTZER=
FERATEL_PASSWORT=
